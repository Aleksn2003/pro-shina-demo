---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Brand from '../components/Brand.astro';
import Calculator from '../components/Calculator.vue';
import CallbackForm from '../components/CallbackForm.vue';
import { workshop as w, money } from '../config/workshop';
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
const asset = (path: string) => `${baseUrl}${path.replace(/^\/+/, '')}`;
const canonical = new URL(baseUrl, w.seo.siteUrl).href;
const structuredData = {
  '@context': 'https://schema.org', '@type': 'TireShop',
  name: w.name, description: w.seo.description, url: canonical,
  telephone: w.phone.href.replace('tel:', ''),
  address: { '@type': 'PostalAddress', streetAddress: w.address.street, addressLocality: w.address.city, addressCountry: w.address.country },
  openingHoursSpecification: { '@type': 'OpeningHoursSpecification', dayOfWeek: w.hours.days.map(day => 'https://schema.org/' + day), opens: w.hours.opens, closes: w.hours.closes },
  hasOfferCatalog: { '@type': 'OfferCatalog', name: w.demo ? 'Демонстрационные услуги' : 'Услуги', itemListElement: w.services.map(s => ({ '@type': 'Offer', priceSpecification: { '@type': 'PriceSpecification', minPrice: s.price, priceCurrency: 'RUB' }, itemOffered: { '@type': 'Service', name: s.title, description: s.text } })) },
};
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#26343c" /><title>{w.seo.title}</title>
    <meta name="description" content={w.seo.description} /><meta name="robots" content={w.seo.indexable && !w.demo ? 'index, follow' : 'noindex, nofollow'} />
    <link rel="canonical" href={canonical} /><link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />
    <meta property="og:type" content="website" /><meta property="og:locale" content="ru_RU" /><meta property="og:title" content={w.seo.title} /><meta property="og:description" content={w.seo.description} /><meta property="og:url" content={canonical} /><meta property="og:site_name" content={w.name} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержимому</a>
    {w.demo && <div class="demo-bar"><div class="container"><span class="demo-tag">ДЕМО</span><span>Шаблон мастерской. Контакты, цены и фотографии — примеры.</span><a href="#demo-details">О шаблоне <span aria-hidden="true">→</span></a></div></div>}
    <header class="site-header">
      <div class="site-header-inner container">
        <Brand name={w.name} />
        <span class="header-location">{w.shortAddress}</span>
        <nav aria-label="Основная навигация"><a href="#services">Услуги</a><a href="#prices">Цены</a><a href="#master">Мастер</a><a href="#contacts">Как добраться</a></nav>
        <a class="header-phone" href={w.phone.href}>{w.phone.display}</a>
        <a class="button button-primary header-call" href={w.phone.href} aria-label="Позвонить"><Icon name="phone" size={17} /><span>Позвонить</span></a>
      </div>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-visual">
          <img src={asset(w.images.hero.src)} srcset={`${asset(w.images.hero.small)} 768w, ${asset(w.images.hero.src)} 1440w`} sizes="100vw" width={w.images.hero.width} height={w.images.hero.height} alt={w.images.hero.alt} fetchpriority="high" />
          <span class="hero-image-label">{w.demo ? 'ДЕМОНСТРАЦИОННОЕ ИЗОБРАЖЕНИЕ' : w.name}</span>
        </div>
        <div class="hero-inner container">
        <div class="hero-content">
          <p class="eyebrow">{w.tagline}</p>
          <h1 id="hero-title">Шиномонтаж<br /><span class="text-accent">{w.location}.</span></h1>
          <p class="hero-description">Ваши колёса.<br />Внимание к каждой детали.</p>
          <p class="hero-copy">Сезонная смена шин, балансировка и ремонт проколов. Звоните — обсудим работы и подскажем, когда подъехать.</p>
          <div class="hero-actions"><a class="button button-primary" href={w.phone.href}><Icon name="phone" size={18} />Позвонить</a><a class="button button-outline" href="#callback">Заказать обратный звонок</a></div>
          <p class="hero-note"><Icon name="clock" size={16} />{w.duration} на комплект <span>· {w.demo ? w.durationNote : 'Ориентир; точное время зависит от работ и очереди.'}</span></p>
        </div>
        <div class="hero-facts"><div class="fact-size"><img class="fact-icon fact-icon-tire" src={asset('/icons/tire.svg')} alt="" aria-hidden="true" width="22" height="22" /><p><strong>{w.tariffs[0].radius.split("–")[0]} — {w.tariffs[w.tariffs.length - 1].radius.split("–").at(-1)}</strong><span>{w.vehicleTypes.map(type => type.label).join(" · ")}</span></p></div><div class="fact-price"><Icon class="fact-icon" name="tag" size={22} /><p><strong>От {money(w.tariffs[0].car)}</strong><span>Смена 4 колёс · пример цены</span></p></div><div class="fact-arrival"><Icon class="fact-icon" name="phone" size={21} /><p><strong>По звонку или в порядке очереди</strong><span>Онлайн-запись не обязательна</span></p></div></div>
        </div>
      </section>
      <section id="services" class="section container services-section">
        <div class="section-heading"><div><p class="eyebrow">УСЛУГИ</p><h2>Что можно сделать.</h2></div><p class="section-aside">Сначала осмотр и согласование.<br />Потом работа.</p></div>
        <div class="service-grid">{w.services.map((s, index) => <article class:list={["service-card", index === 0 ? "service-card-featured" : "service-card-compact"]}>
          <div class="service-image-wrap"><img class="service-image" src={asset(s.image.src)} alt={s.image.alt} width={index === 0 ? "1200" : "800"} height={index === 0 ? "800" : "560"} loading="lazy" decoding="async" /><span class="service-kicker">{index === 0 ? "ОСНОВНАЯ УСЛУГА · ДЕМО" : `РАБОТА ${s.number} · ДЕМО`}</span></div>
          <div class="service-body"><h3>{s.title}</h3><p>{s.text}</p><div class="service-price"><strong>от {money(s.price)}</strong><span>{s.unit} · пример тарифа</span></div></div>
        </article>)}</div>
      </section>
      <section id="prices" class="section container prices-section">
        <div class="section-heading"><div><p class="eyebrow">ЦЕНЫ · ДЕМОНСТРАЦИОННЫЕ</p><h2>Сколько стоит смена шин.</h2></div><a class="text-link" href="#calculator">Рассчитать комплект <Icon name="arrow" size={20} /></a></div>
        <div class="price-layout"><div class="price-table-wrap"><div class="price-table-heading"><div><strong>Сезонная смена шин</strong><span>Цена за комплект из 4 колёс</span></div><span class="price-demo-tag">ПРИМЕР ТАРИФОВ</span></div><table><thead><tr><th scope="col">Радиус</th>{w.vehicleTypes.map((t, index) => <th scope="col" class:list={[index === 0 ? "price-primary-column" : ""]}>{t.label}</th>)}</tr></thead><tbody>{w.tariffs.map(t => <tr><th scope="row">{t.radius}</th><td class="price-primary-cell">{money(t.car)}</td><td>{money(t.suv)}</td></tr>)}</tbody></table></div><aside class="included-card"><div class="included-title"><span class="included-mark"><Icon name="check" size={18} /></span><div><h3>Что входит в комплект</h3><span>Демонстрационный состав работ</span></div></div><ul>{w.included.map(item => <li><Icon name="check" size={17} />{item}</li>)}</ul><p class="price-exclusions"><strong>Отдельно после осмотра</strong>{w.exclusions}</p></aside></div>
      </section>
      <section id="calculator" class="container calculator-section">
        <div class="calculator-title"><div><p class="eyebrow">БЕЗ СЮРПРИЗОВ</p><h2>Посчитаем ваш комплект?</h2></div><span class="outline-tag">ДЕМОКАЛЬКУЛЯТОР</span></div>
        <Calculator client:visible tariffs={w.tariffs} vehicleTypes={w.vehicleTypes} extras={w.extras} exclusions={w.exclusions} demo={w.demo} />
        <noscript><p class="fineprint">Для изменения расчёта включите JavaScript. Все тарифы приведены в таблице выше.</p></noscript>
      </section>
      <section class="section container workshop-section" aria-labelledby="approach-title">
        <div class="section-heading"><div><p class="eyebrow">В МАСТЕРСКОЙ</p><h2 id="approach-title">Небольшая мастерская.<br />Всё по делу.</h2></div><p class="section-aside">Показываем пример оснащения<br />и условий одного бокса.</p></div>
        <div class="workshop-feature">
          <figure class="workshop-photo"><img src={asset(w.benefits[0].image.src)} alt={w.benefits[0].image.alt} width="1200" height="820" loading="lazy" decoding="async" /><figcaption>ДЕМОНСТРАЦИОННОЕ ФОТО · ЗАМЕНИТЬ НА СНИМОК БОКСА</figcaption></figure>
          <div class="workshop-details"><p class="workshop-intro">{w.customerGuide.workTitle}<span class="guide-demo">· пример процесса, подтвердите перед запуском</span></p><ol class="work-steps">{w.customerGuide.workSteps.map(step => <li>{step}</li>)}</ol><div class="workshop-points">{w.benefits.slice(0, 4).map((b, index) => <article class="workshop-point"><span class="workshop-point-number">0{index + 1}</span><div><h3>{b.title}</h3><p>{b.text}</p></div><span class="demo-mark">ДЕМО</span></article>)}</div></div>
        </div>
      </section>
      <section id="master" class="container master-section">
        <div class="master-photo">{w.images.master ? <img src={asset(w.images.master)} alt={w.demo ? w.images.masterAlt : `${w.master.name}, ${w.master.role}`} width="760" height="950" loading="lazy" decoding="async" /> : <div class="photo-placeholder"><span class="portrait-initials">{w.master.initials}</span><span><Icon name="image" size={20} />Здесь будет фото мастера</span></div>}<span class="photo-tag">{w.demo ? 'ДЕМОНСТРАЦИОННОЕ ФОТО' : w.master.role}</span></div>
        <div class="master-copy"><p class="eyebrow">МАСТЕР</p><h2>Работаю сам.<br />Отвечаю за результат.</h2><blockquote>«{w.master.quote}»</blockquote></div>
        <aside class="master-meta" aria-label="О мастере"><div><span class="master-meta-label">ИМЯ</span><strong>{w.master.name}</strong><span>{w.master.role}</span></div><div><span class="master-meta-label">ОПЫТ</span><strong>{w.master.experience}</strong><span>демонстрационный пример</span></div><p>{w.master.note}</p></aside>
      </section>
      <section id="callback" class="container callback-section"><div><p class="eyebrow">ПРОЩЕ ОБСУДИТЬ ПО ТЕЛЕФОНУ</p><h2>Колёса подождут.<br />Оставьте номер.</h2><p>Уточним размер, работы и стоимость.<br />Или позвоните сами: <a href={w.phone.href}>{w.phone.display}</a></p><aside class="call-guide"><div class="call-guide-heading"><h3>{w.customerGuide.phoneTitle}</h3><span>{w.customerGuide.phoneNote}</span></div><p>{w.customerGuide.phoneIntro}</p><ul>{w.customerGuide.phoneDetails.map(detail => <li>{detail}</li>)}</ul></aside></div><div><CallbackForm client:visible {...w.callback} demo={w.demo} /><noscript><p class="fineprint">Для формы нужен JavaScript. Контакты и телефон доступны без него.</p></noscript></div></section>
      <section id="contacts" class="section container">
        <div class="section-heading"><div><p class="eyebrow">АДРЕС И МАРШРУТ</p><h2>Как найти мастерскую.</h2></div><span class="outline-tag">ДЕМОАДРЕС</span></div>
        <div class="contact-layout"><div class="contact-info"><address><div><Icon name="pin" /><p><strong>{w.address.street}</strong><span>{w.address.city} · {w.location}</span></p></div><div><Icon name="clock" /><p><strong>{w.hours.label}</strong><span>Пример часов работы</span></p></div><div><Icon name="phone" /><p><a href={w.phone.href}><strong>{w.phone.display}</strong></a><span>Демонстрационный номер</span></p></div></address><p class="directions">{w.directions}</p><div class="route-buttons">{w.routes.map(route => <a class="button button-outline" href={route.href} target="_blank" rel="noopener noreferrer" aria-label={`${route.name}: ${route.note}`}><Icon name="pin" size={17} />{route.name}</a>)}</div><p class="fineprint">Пример адреса и ориентиров. Ссылки открывают карты без точки мастерской; маршрут появится после замены данных.</p></div><div class="entrance-photo">{w.images.entrance ? <img src={asset(w.images.entrance)} alt={w.images.entranceAlt} width="900" height="600" loading="lazy" decoding="async" /> : <div class="photo-placeholder"><Icon name="image" size={42} /><strong>Здесь начинается<br />знакомство с боксом.</strong><span>Место для фотографии въезда</span></div>}<span class="photo-tag">{w.demo ? 'ДЕМО · ПРИМЕР ВЪЕЗДА' : w.name}</span></div></div>
      </section>
    </main>
    <footer class="site-footer"><div class="container"><div class="footer-top"><div><Brand name={w.name} /><p>{w.tagline}</p></div><address><a href={w.phone.href}>{w.phone.display}</a><span>{w.address.city}, {w.address.street}</span><span>{w.hours.label}</span></address></div><div id="demo-details" class="demo-details"><p>{w.demo ? 'Демонстрационный шаблон. Название, телефон, адрес, тарифы, часы, опыт, оборудование и условия — заменяемые примеры, а не сведения о действующей мастерской.' : w.legal.companyDetails}</p>{w.legal.privacyUrl ? <a href={w.legal.privacyUrl}>Политика обработки персональных данных</a> : <p>Владелец добавит настоящие реквизиты, политику обработки данных и условия согласия.</p>}</div><div class="footer-bottom"><span>© {new Date().getFullYear()} {w.name}{w.demo ? ' · Демо' : ''}</span><span>С заботой о каждом обороте.</span></div><div class="author-credit"><span>Сайт и шаблон: <a href={w.attribution.url} target="_blank" rel="noopener noreferrer">{w.attribution.author}</a></span><span>{w.attribution.notice}</span></div></div></footer>
    <aside class="scroll-call-prompt" id="scroll-call-prompt" aria-hidden="true" aria-labelledby="scroll-call-title">
      <button class="scroll-call-close" type="button" aria-label="Закрыть подсказку">×</button>
      <span class="hero-guide-label">{w.demo ? 'ПОДСКАЗКА · ДЕМО' : 'ПЕРЕД ЗВОНКОМ'}</span>
      <h2 id="scroll-call-title">{w.customerGuide.heroTitle}</h2>
      <p>{w.customerGuide.heroText}</p>
    </aside>
    <a class="back-to-top" href="#main" aria-label="Наверх">↑</a>
    <script is:inline>
      (() => {
        const backToTop = document.querySelector('.back-to-top');
        const prompt = document.querySelector('#scroll-call-prompt');
        const hero = document.querySelector('.hero');
        let dismissed = false;
        const updateVisibility = () => {
          if (backToTop) backToTop.classList.toggle('is-visible', window.scrollY > 600);
          if (prompt && hero && !dismissed) {
            const visible = hero.getBoundingClientRect().bottom < window.innerHeight * 0.55;
            prompt.classList.toggle('is-visible', visible);
            prompt.setAttribute('aria-hidden', String(!visible));
          }
        };
        prompt?.querySelector('.scroll-call-close')?.addEventListener('click', () => {
          dismissed = true;
          prompt.classList.remove('is-visible');
          prompt.setAttribute('aria-hidden', 'true');
        });
        updateVisibility();
        window.addEventListener('scroll', updateVisibility, { passive: true });
      })();
    </script>
    <nav class="mobile-action-bar" aria-label="Быстрая связь"><a class="button button-primary" href={w.phone.href}><Icon name="phone" size={18} />Позвонить</a><a class="button button-outline" href="#callback">Заказать звонок</a></nav>
  </body>
</html>





